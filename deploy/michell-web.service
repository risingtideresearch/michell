# michell-web as a service: bound to loopback, reached through
# `tailscale serve` (see deploy/README.md), its store in /var/lib/michell.
[Unit]
Description=michell web: hulls, configurations and a queue of runs
After=network-online.target
Wants=network-online.target

[Service]
User=michell
Group=michell
ExecStart=/usr/local/bin/michell-web --host 127.0.0.1 --port 8080 --data /var/lib/michell
Restart=on-failure
RestartSec=5
# The solver fans out across every core; leave the machine responsive.
Nice=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/michell
StateDirectory=michell

[Install]
WantedBy=multi-user.target
